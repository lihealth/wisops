# WisOps 环境变量配置模板
# 使用方法：复制本文件为 .env，替换占位值后再启动服务
# 注意：.env 文件已加入 .gitignore，不会提交到 git

# ── PostgreSQL ──
POSTGRES_PASSWORD=请替换为强密码
POSTGRES_DB=wisops

# ── Dify 应用密钥（生产环境必须替换） ──
SECRET_KEY=请替换为随机字符串(建议32位以上)

# ── Redis（如需密码保护，取消注释） ──
# REDIS_PASSWORD=请替换为Redis密码

# ── HugeGraph ──
HUGEGRAPH_GRAPH=hugegraph

# ── 访问地址（本地开发默认值，部署到服务器时修改为实际IP/域名） ──
CONSOLE_WEB_URL=http://localhost:8281
APP_WEB_URL=http://localhost:8281

# ── 端口映射（如需修改默认端口，同步修改 docker-compose.yml） ──
# Dify Web:    8281
# Dify API:    5002
# HugeGraph:   8081
# graph-api:   8002
# graph-ui:    8282
# PostgreSQL:  5433
# Redis:       6380
# Qdrant:      6334
