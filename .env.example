# WisOps V2.0 环境变量配置模板
# 复制此文件为 .env 并填写真实值（.env 已加入 .gitignore，禁止提交）

# ─── 数据库 ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=wisops

# ─── Dify 安全密钥（生产环境请替换为随机字符串） ─────────────────────────────
SECRET_KEY=your_secret_key_here_min_32_chars

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ─── HugeGraph ───────────────────────────────────────────────────────────────
HUGEGRAPH_GRAPH=hugegraph

# ─── graph-api V2.0 ──────────────────────────────────────────────────────────
# LLM API（可选，用于知识抽取。兼容 OpenAI Chat API 格式）
# 留空则降级为规则抽取
LLM_API_URL=
LLM_API_KEY=

# ─── wisops-portal ───────────────────────────────────────────────────────────
# Dify 应用 API Key（可选，也可在 portal 页面内输入）
VITE_DIFY_API_KEY=

# ─── 访问地址 ─────────────────────────────────────────────────────────────────
CONSOLE_API_URL=http://localhost:5002
APP_API_URL=http://localhost:5002
