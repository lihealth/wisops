# WisOps .env 配置示例
# 复制此文件为 .env，填写实际值后启动。
# .env 已加入 .gitignore，不会提交至仓库。

# ── Dify 核心密钥（必填，与官方 docker-compose 保持一致）────────────────────
SECRET_KEY=your-secret-key-change-me
INIT_PASSWORD=your-init-password

# ── LLM（抽取与嵌入）────────────────────────────────────────────────────────
# 兼容 OpenAI Chat API（DeepSeek / 千问 / OpenAI 等）
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_CHAT_MODEL=gpt-4o-mini

# ── 嵌入模型（向量检索/相似推荐）────────────────────────────────────────────
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Dify 知识库自动同步（抽取审核通过后写入 Dify）────────────────────────────
# 在 Dify 控制台创建知识库后填写 dataset_id
DIFY_DATASET_API_URL=http://api:5001/v1
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=dataset-xxxx

# ── HugeGraph────────────────────────────────────────────────────────────────
HUGEGRAPH_GRAPH=hugegraph

# ── SEC：Graph API 写操作鉴权 ───────────────────────────────────────────────
# 设置后，所有 POST/PUT/DELETE 请求需携带请求头：X-API-Key: <值>
# 留空则不校验（本地开发模式，生产建议设置）
GRAPH_API_KEY=

# 审计日志内存最大条目数（超出时滚动丢弃最旧条目）
AUDIT_MAX_ENTRIES=2000

# ── 前端（portal 构建时注入，运行时不可更改）────────────────────────────────
# Dify 应用 API Key（非知识库 Key；可在 portal 页面右上角 🔑 动态填写，此处为默认值）
VITE_DIFY_API_KEY=app-xxxx

# ── Qdrant（向量库）─────────────────────────────────────────────────────────
QDRANT_COLLECTION=fault_vectors
