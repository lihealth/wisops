# Python 虚拟环境
graph-api/.venv/
**/__pycache__/
**/*.pyc
**/*.pyo
*.egg-info/

# 前端依赖与构建产物
**/node_modules/
**/dist/
**/.vite/

# 环境变量与密钥（绝对不能提交）
.env
.env.local
.env.*.local

# Docker 数据卷（本地生成，不入库）
data/pg_data/
data/qdrant_data/
data/hugegraph_data/
data/api_storage/

# 外部数据集（按需下载，不入库）
data/gaia/
# Stack Exchange 全量 Posts.xml / 压缩包（样例 XML 与 README 可入库）
data/stackoverflow/Posts.xml
data/stackoverflow/*.7z
data/stackoverflow/*.zip

# 临时调研脚本
scripts/_*.py

# 编辑器与系统文件
.vscode/
.idea/
*.DS_Store
Thumbs.db

# 日志
*.log
logs/
